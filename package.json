{
  "name": "telurify-notifications",
  "version": "0.1.0",
  "private": true,
  "description": "Web push earthquake notifications for Telurify",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node --transpile-only src/main.ts",
    "test": "jest --runInBand",
    "lint": "eslint \"{src,api,test}/**/*.ts\""
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@upstash/redis": "^1.35.3",
    "firebase-admin": "^14.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
